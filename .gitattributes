# These files are executed by a shell, or shipped to a Linux host, so they must keep
# LF endings whatever the checkout platform does. With core.autocrlf=true on Windows
# and no rule here, a shell script checks out with CRLF and every line fails with
# "$'\r': command not found".
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
deploy/Caddyfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
