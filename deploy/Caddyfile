# TLS terminates here with a Let's Encrypt certificate for the hostname in
# /paygo/public-host, which Caddy obtains and renews on its own. That needs the name
# to resolve to this instance and ports 80 and 443 to be reachable, nothing else.
#
# The certificate and the ACME account live in the caddy_data volume. Keep it:
# Let's Encrypt limits how often a name can be issued, and a host that loses the
# volume and redeploys repeatedly can be refused a certificate for days.
#
# With a bare IP address instead of a hostname, add "tls internal" to the site block
# below. Caddy's own CA then issues the certificate and clients see an untrusted
# warning: encrypted, but nothing proves the host is the one they meant to reach.

{
	admin off
	# The redirect is written out below so a probe on port 80 gets an explicit answer.
	auto_https disable_redirects
	# A client connecting to a bare IP address sends no SNI, and Caddy then picks the
	# certificate by the connection's local address. Inside Docker that is the
	# container's own 172.x address, which matches no certificate, so the handshake
	# ends in a TLS "internal error" alert even though the certificate exists. Harmless
	# once the address is a hostname, since browsers always send SNI for a name.
	default_sni {$PAYGO_PUBLIC_HOST}
}

https://{$PAYGO_PUBLIC_HOST} {
	encode zstd gzip

	# The app reads X-Forwarded-For for its per-IP login limit and trusts exactly one
	# hop (TRUST_PROXY=1), which is this proxy.
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Plain HTTP answers only so a probe gets a clear redirect rather than a dead port.
http://{$PAYGO_PUBLIC_HOST} {
	redir https://{$PAYGO_PUBLIC_HOST}{uri} permanent
}
