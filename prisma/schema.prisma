// PayGo — pay-as-you-go motorbike financing.
// See CLAUDE.md for the conventions this schema follows. The most important one:
// `User` (staff) and `Customer` (rider) are deliberately separate models. Do not merge
// them into one table with a role column, and do not add a customer value to StaffRole.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

/// Back-office staff roles. Customers are NOT a role here — they are a separate
/// model with their own identity and authentication path.
enum StaffRole {
  ADMIN
  FIELD_AGENT
}

// ---------------------------------------------------------------------------
// Staff
// ---------------------------------------------------------------------------

/// Staff who sign in to the back office. Never holds customers.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?   @unique
  role         StaffRole
  branch       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  /// Per-account brute force protection, independent of the IP rate limit. Reset on a
  /// successful login. Short lockouts on purpose: a long one lets an attacker who knows an
  /// admin's email lock them out at will.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// Self-relation: the agent's supervisor.
  supervisorId String? @db.Uuid
  supervisor   User?   @relation("StaffSupervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates User[]  @relation("StaffSupervision")

  /// Customers this agent currently owns. Drives the "an agent may not touch
  /// another agent's customers" boundary — enforced in the service, not just the guard.
  assignedCustomers    Customer[] @relation("CustomerAssignedAgent")
  registeredCustomers  Customer[] @relation("CustomerRegisteredBy")
  kycVerifiedCustomers Customer[] @relation("CustomerKycVerifiedBy")

  refreshTokens      RefreshToken[]
  enforcementActions EnforcementEvent[]

  trackersInstalled    BikeTrackerInstallation[] @relation("TrackerInstalledBy")
  trackersRemoved      BikeTrackerInstallation[] @relation("TrackerRemovedBy")
  bikesAssigned        BikeAssignment[]          @relation("BikeAssignedBy")
  bikeAssignmentsEnded BikeAssignment[]          @relation("BikeAssignmentEndedBy")
  bikeStatusChanges    BikeStatusChange[]        @relation("BikeStatusChangedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([supervisorId])
  @@map("users")
}

/// A refresh token, stored only as a SHA-256 hash: the database must not contain anything
/// that can be replayed if it leaks. Opaque random bytes rather than a JWT, so revoking one
/// is a row update instead of a blocklist.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime

  /// Set when the token is used (rotated) or explicitly logged out. A presented token that
  /// is already revoked means the token leaked, and the whole family is then revoked.
  revokedAt    DateTime?
  /// The token issued in this one's place, so a reuse can be traced through the chain.
  replacedById String?   @db.Uuid

  /// Recorded for audit, never trusted for authorization.
  userAgent String?
  ipAddress String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Customers (riders)
// ---------------------------------------------------------------------------

enum CustomerStatus {
  PENDING_KYC
  ACTIVE
  SUSPENDED
  DEFAULTED
  CLOSED
}

/// A rider being financed. Identity is the phone number — a field agent registers
/// them, and many never sign in at all. `passwordHash` is deliberately absent: if a
/// rider app ships, it authenticates by phone + OTP on its own path.
model Customer {
  id     String         @id @default(uuid()) @db.Uuid
  status CustomerStatus @default(PENDING_KYC)

  // Identity
  phone           String    @unique
  alternatePhone  String?
  phoneVerifiedAt DateTime?

  firstName String
  lastName  String

  // KYC
  nationalId    String    @unique
  photoUrl      String?
  idDocumentUrl String?
  dateOfBirth   DateTime? @db.Date
  kycVerifiedAt DateTime?

  kycVerifiedById String? @db.Uuid
  kycVerifiedBy   User?   @relation("CustomerKycVerifiedBy", fields: [kycVerifiedById], references: [id], onDelete: SetNull)

  // Address
  addressLine String?
  ward        String?
  district    String?
  region      String?

  // Ownership. Registration is historical fact and never changes; assignment moves
  // when a customer is handed to another agent.
  registeredById String @db.Uuid
  registeredBy   User   @relation("CustomerRegisteredBy", fields: [registeredById], references: [id])

  assignedAgentId String? @db.Uuid
  assignedAgent   User?   @relation("CustomerAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  contacts CustomerContact[]

  /// Set with status CLOSED. Riders are deactivated, never deleted, so their history survives.
  deactivatedAt      DateTime?
  deactivationReason String?

  /// Every bike this rider has held, past and present. Contracts will hang off these once
  /// they exist; until then this is the rider's financing history.
  bikeAssignments BikeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedAgentId])
  @@index([status])
  @@map("customers")
}

enum ContactType {
  GUARANTOR
  NEXT_OF_KIN
}

/// Guarantors and next of kin. One model because the fields are identical and the
/// only difference is what the person is on the hook for.
model CustomerContact {
  id   String      @id @default(uuid()) @db.Uuid
  type ContactType

  firstName    String
  lastName     String
  phone        String
  relationship String?
  nationalId   String?
  addressLine  String?

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, type])
  @@map("customer_contacts")
}

// ---------------------------------------------------------------------------
// Fleet tracking
// ---------------------------------------------------------------------------

/// Where a bike is in its life. Mobility (immobilized or not) is deliberately NOT a status here:
/// it belongs to enforcement, which is the only thing that knows what the device confirmed.
/// Status moves only through the actions in the assets module, never by direct assignment, so
/// it cannot disagree with the assignment history.
enum BikeStatus {
  IN_INVENTORY
  ASSIGNED
  REPOSSESSED
  SOLD
  RETIRED
}

/// A financed motorbike, from the moment it enters inventory. `imei` is the tracker installed
/// right now (null before one is fitted); BikeTrackerInstallation holds every past one.
model Bike {
  id                 String  @id @default(uuid()) @db.Uuid
  imei               String? @unique
  /// Short fleet name shown on the map, e.g. "Bike 7".
  label              String
  /// Number plate.
  registrationNumber String? @unique
  /// Chassis number. The one identifier that never changes over the bike's life.
  vin                String  @unique
  make               String
  model              String
  year               Int?
  color              String?

  /// Purchase cost in minor units, with its currency. Both or neither (database check).
  purchasePriceMinor Int?
  purchaseCurrency   String?   @db.Char(3)
  purchasedAt        DateTime? @db.Date
  supplier           String?

  status    BikeStatus @default(IN_INVENTORY)
  retiredAt DateTime?

  lastReportedAt       DateTime?
  positions            BikePosition[]
  currentPosition      BikeCurrentPosition?
  enforcement          BikeEnforcement?
  enforcementEvents    EnforcementEvent[]
  trackerInstallations BikeTrackerInstallation[]
  assignments          BikeAssignment[]
  statusChanges        BikeStatusChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("bikes")
}

/// Every tracker ever fitted to a bike. At most one open row per bike and per IMEI, enforced by
/// partial unique indexes in the migration (Prisma cannot express them).
model BikeTrackerInstallation {
  id     String @id @default(uuid()) @db.Uuid
  bikeId String @db.Uuid
  bike   Bike   @relation(fields: [bikeId], references: [id], onDelete: Restrict)
  imei   String

  installedAt   DateTime  @default(now())
  /// Null only for trackers fitted before installation history was kept (backfilled rows).
  installedById String?   @db.Uuid
  installedBy   User?     @relation("TrackerInstalledBy", fields: [installedById], references: [id], onDelete: Restrict)
  removedAt     DateTime?
  removedById   String?   @db.Uuid
  removedBy     User?     @relation("TrackerRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)
  removedReason String?

  @@index([bikeId, installedAt])
  @@index([imei])
  @@map("bike_tracker_installations")
}

enum AssignmentEndReason {
  /// Handed back to inventory.
  RETURNED
  /// Moved to another rider; the next assignment starts at the same moment.
  TRANSFERRED
  /// Taken back for non-payment.
  REPOSSESSED
  /// Paid off and ownership passed to the rider.
  SOLD
}

/// Which rider holds a bike, and when. Never deleted, so a rider's history across bikes and a
/// bike's history across riders both survive. At most one open row per bike (partial unique
/// index in the migration), which is what makes a double assignment impossible even under a
/// race, not just unlikely.
model BikeAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  bikeId     String   @db.Uuid
  bike       Bike     @relation(fields: [bikeId], references: [id], onDelete: Restrict)
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  startedAt    DateTime @default(now())
  assignedById String   @db.Uuid
  assignedBy   User     @relation("BikeAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  endedAt   DateTime?
  endReason AssignmentEndReason?
  endedById String?              @db.Uuid
  endedBy   User?                @relation("BikeAssignmentEndedBy", fields: [endedById], references: [id], onDelete: Restrict)
  notes     String?

  @@index([bikeId, startedAt])
  @@index([customerId, startedAt])
  @@map("bike_assignments")
}

/// Append-only log of every status change, with who made it and why.
model BikeStatusChange {
  id          String      @id @default(uuid()) @db.Uuid
  bikeId      String      @db.Uuid
  bike        Bike        @relation(fields: [bikeId], references: [id], onDelete: Restrict)
  fromStatus  BikeStatus?
  toStatus    BikeStatus
  reason      String
  actorUserId String      @db.Uuid
  actor       User        @relation("BikeStatusChangedBy", fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())

  @@index([bikeId, createdAt])
  @@map("bike_status_changes")
}

/// Append-only, queryable telemetry history. Device retries for the same timestamp are
/// idempotent, while server receive time remains separate for online/offline calculations.
/// Restrict, not Cascade: bikes are retired, never deleted, and history must not vanish.
model BikePosition {
  id         String   @id @default(uuid()) @db.Uuid
  bikeId     String   @db.Uuid
  bike       Bike     @relation(fields: [bikeId], references: [id], onDelete: Restrict)
  recordedAt DateTime
  receivedAt DateTime
  latitude   Float
  longitude  Float
  altitude   Int
  angle      Int
  satellites Int
  speed      Int
  ignition   Boolean?
  movement   Boolean?
  hasFix     Boolean

  @@unique([bikeId, recordedAt])
  @@index([bikeId, recordedAt])
  @@map("bike_positions")
}

/// One latest known telemetry snapshot per bike, maintained only when an event is newer.
model BikeCurrentPosition {
  bikeId     String   @id @db.Uuid
  bike       Bike     @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  recordedAt DateTime
  receivedAt DateTime
  latitude   Float
  longitude  Float
  altitude   Int
  angle      Int
  satellites Int
  speed      Int
  ignition   Boolean?
  movement   Boolean?
  hasFix     Boolean

  @@index([receivedAt])
  @@map("bike_current_positions")
}

// ---------------------------------------------------------------------------
// Enforcement
// ---------------------------------------------------------------------------

enum MobilityState {
  MOBILE
  IMMOBILIZED
}

/// Who set the current desired state. Arrears decisions are revisited by the sweep; a staff
/// decision is not, so a manual lock is never silently undone by the next sweep.
enum DesiredStateSource {
  ARREARS
  STAFF
}

enum EnforcementEventType {
  DESIRED_STATE_CHANGED
  COMMAND_SENT
  COMMAND_FAILED
  COMMAND_DEFERRED
  STATE_CONFIRMED
  RESPONSE_UNRECOGNIZED
  REVIEW_FLAGGED
  /// The tracker was installed, replaced or removed, so the confirmed state no longer describes
  /// the device that is now fitted.
  TRACKER_CHANGED
}

/// Desired versus device-confirmed mobility for one bike. The reconciler is the only thing that
/// turns a difference between them into a command.
model BikeEnforcement {
  bikeId String @id @db.Uuid
  bike   Bike   @relation(fields: [bikeId], references: [id], onDelete: Restrict)

  desiredState  MobilityState      @default(MOBILE)
  desiredSource DesiredStateSource @default(ARREARS)

  /// Null until the device has confirmed a state. Unknown is not MOBILE.
  confirmedState MobilityState?
  confirmedAt    DateTime?

  /// The last command written and not yet confirmed. A write is not confirmation.
  pendingCommand MobilityState?
  pendingSentAt  DateTime?

  /// Why the last reconcile did not act. An audit entry is written only when this changes, so
  /// a sweep repeating the same deferral does not flood the log.
  blockedReason String?

  /// Set when an immobilize is wanted but telemetry is missing, stale or offline, and a person
  /// should look instead of the system acting on data it cannot trust.
  reviewReason String?
  reviewSince  DateTime?

  updatedAt DateTime @updatedAt

  @@index([reviewReason])
  @@map("bike_enforcement")
}

/// Append-only audit trail of every enforcement decision. Never updated or deleted: this is
/// what answers a rider disputing an immobilization.
model EnforcementEvent {
  id     String @id @default(uuid()) @db.Uuid
  bikeId String @db.Uuid
  bike   Bike   @relation(fields: [bikeId], references: [id], onDelete: Restrict)

  type EnforcementEventType

  /// Null for automatic actions. Set for a staff member's decision.
  actorUserId String? @db.Uuid
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  /// What triggered it: sweep, staff, device-connected, telemetry, command-response, timer.
  trigger String

  fromState MobilityState?
  toState   MobilityState?
  reason    String

  /// The telemetry the interlock relied on, and any arrears snapshot, as they were at the time.
  telemetry      Json?
  detail         Json?
  deviceResponse String?

  createdAt DateTime @default(now())

  @@index([bikeId, createdAt])
  @@map("enforcement_events")
}
