# Copy to .env and fill in. Every variable the app reads is listed here.

NODE_ENV=development
PORT=3000

# Postgres. Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://paygo:paygo@localhost:5432/paygo?schema=public"

# RS256 JWT keypair, base64-encoded PEM so each fits on one line.
# Generate a pair with:
#   node -e "const {generateKeyPairSync}=require('crypto');const k=generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('JWT_PRIVATE_KEY_BASE64=\"'+Buffer.from(k.privateKey).toString('base64')+'\"');console.log('JWT_PUBLIC_KEY_BASE64=\"'+Buffer.from(k.publicKey).toString('base64')+'\"')"
# Use a different pair per environment and never commit one.
JWT_PRIVATE_KEY_BASE64=""
JWT_PUBLIC_KEY_BASE64=""
JWT_EXPIRES_IN="15m"
JWT_ISSUER="paygo"

# First admin, read only by `npm run db:seed`. Minimum 12 characters.
SEED_ADMIN_EMAIL="admin@paygo.local"
SEED_ADMIN_PASSWORD=""

# Refresh tokens. Rotated on every use; a replayed token revokes the whole family.
REFRESH_TOKEN_TTL_DAYS="30"

# Login protection, two independent layers:
#   LOGIN_RATE_*        per IP, via the throttler
#   LOGIN_MAX_ATTEMPTS  per account, since a distributed attack on one email comes from
#                       many IPs. Keep the lockout short: a long one lets an attacker who
#                       knows an admin's email keep them locked out.
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
LOGIN_RATE_LIMIT="10"
LOGIN_RATE_WINDOW_SECONDS="60"

# Swagger is mounted at /api except in production. Set true to publish it there too.
# SWAGGER_ENABLED=false

# --- Not yet consumed by code; listed so deployments can be prepared ---

# BullMQ
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Teltonika device TCP listener. Set TCP_DEVICE_ENABLED=false to run the HTTP API without
# opening the device port (npm run test:e2e sets it, so parallel suites do not fight over it).
TCP_DEVICE_ENABLED="true"
TCP_DEVICE_PORT="5027"

# Tracking: quiet period before a bike is reported offline
TRACKING_OFFLINE_AFTER_SECONDS="300"

# Enforcement. The tracker's on-stop report period must be shorter than the max telemetry
# age, or a parked bike never has fresh enough data to be immobilized.
IMMOBILIZE_STATIONARY_SECONDS="120"
ENFORCEMENT_MAX_TELEMETRY_AGE_SECONDS="300"
ENFORCEMENT_COMMAND_RETRY_SECONDS="300"
ENFORCEMENT_SWEEP_INTERVAL_SECONDS="900"

# Paystack. The webhook signature is an HMAC-SHA512 of the raw body with this key; without it
# the webhook refuses every request. Never commit a live key.
# PAYSTACK_SECRET_KEY="sk_test_replace_me"
