# Copy to .env and fill in. Every variable the app reads is listed here.

NODE_ENV=development
PORT=3000

# Postgres. Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://paygo:paygo@localhost:5432/paygo?schema=public"

# RS256 JWT keypair, base64-encoded PEM so each fits on one line.
# Generate a pair with:
#   node -e "const {generateKeyPairSync}=require('crypto');const k=generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('JWT_PRIVATE_KEY_BASE64=\"'+Buffer.from(k.privateKey).toString('base64')+'\"');console.log('JWT_PUBLIC_KEY_BASE64=\"'+Buffer.from(k.publicKey).toString('base64')+'\"')"
# Use a different pair per environment and never commit one.
JWT_PRIVATE_KEY_BASE64=""
JWT_PUBLIC_KEY_BASE64=""
JWT_EXPIRES_IN="15m"
JWT_ISSUER="paygo"

# First admin, read only by `npm run db:seed`. Minimum 12 characters.
SEED_ADMIN_EMAIL="admin@paygo.local"
SEED_ADMIN_PASSWORD=""

# Swagger is mounted at /api except in production. Set true to publish it there too.
# SWAGGER_ENABLED=false

# --- Not yet consumed by code; listed so deployments can be prepared ---

# BullMQ
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Teltonika device TCP listener
# TCP_DEVICE_PORT=5027

# Enforcement
# IMMOBILIZE_STATIONARY_SECONDS=120
# RESTORE_ARREARS_THRESHOLD=0
